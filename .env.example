# --- IPFS (Pinata) ---
# Create a free account at https://pinata.cloud, then generate a JWT under
# API Keys with "pinFileToIPFS" and "pinJSONToIPFS" permissions.
# This stays server-side only (used in app/api/upload/route.ts) and is
# never exposed to the browser.
PINATA_JWT=

# Optional: custom Pinata gateway domain (defaults to gateway.pinata.cloud)
PINATA_GATEWAY=gateway.pinata.cloud

# --- BNB Smart Chain RPC ---
# The public https://bsc-dataseed.binance.org endpoint is used by default
# and is fine to start with, but is rate-limited under real traffic. For
# production, use a paid RPC provider: NodeReal, Ankr, QuickNode, Alchemy,
# GetBlock, etc.
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org

# --- Robinhood Chain RPC (mainnet + testnet) ---
# Defaults to the public endpoints below, which are rate-limited under real
# traffic. For production, use a paid RPC provider (QuickNode, Alchemy,
# Blockdaemon, dRPC, Validation Cloud all support Robinhood Chain).
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Optional: BscScan API key ---
# If set, the token dashboard (app/api/token/[address]/route.ts) uses it to
# show an approximate holder count for BNB Chain tokens. Free key from
# https://bscscan.com/apis. Leave blank and the dashboard simply shows
# "Unavailable" for holder count. (Robinhood Chain holder counts aren't
# wired up yet regardless of this key — see README.)
BSCSCAN_API_KEY=
